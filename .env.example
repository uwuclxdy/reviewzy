# reviewzy configuration. copy to `.env` and edit; `.env` is gitignored and never committed.
# every variable below is optional. an unset variable takes the default shown.

# --- daemon ---
# port the daemon serves the dashboard and the mcp endpoint on. it always binds 127.0.0.1.
REVIEWZY_PORT=3123
# sqlite file. defaults to $XDG_DATA_HOME/reviewzy/reviewzy.db, or ~/.local/share/reviewzy/reviewzy.db.
REVIEWZY_DB=
# absolute url the dashboard is reachable at, used in notification links. defaults to http://127.0.0.1:$REVIEWZY_PORT.
REVIEWZY_BASE_URL=

# --- auth ---
# both credentials follow one rule: set it and it is required, leave it unset and the surface
# is loopback-only with a startup warning.
# bearer token guarding the mcp endpoint.
REVIEWZY_TOKEN=
# password guarding the dashboard, as a login form plus a signed session cookie.
DASHBOARD_PASSWORD=

# --- retention ---
# applied entries move into the archive table after this many days.
ARCHIVE_AFTER_DAYS=90

# --- notifications ---
# ntfy and the generic webhook are independently togglable. a transport fires only when its
# url is set.
NTFY_URL=
NTFY_TOPIC=
NTFY_PRIORITY=3
WEBHOOK_URL=
